#!/usr/bin/env python3
"""
MCP Server for LXD Container Management using pylxd
This server bridges between an LLM and LXD containers on the same host.
"""

import asyncio
import json
import logging
import subprocess
import sys
import os
from typing import Dict, Any, List, Optional
from dataclasses import dataclass, asdict

# Prevent pylxd from printing a warning on startup for a feature 
# that is only available in unstable pylxd yet (requestor)
os.environ["PYLXD_WARNINGS"] = "none"

import pylxd
from pylxd import Client

# === 1. MCP V2 IMPORTS ===
from mcp.server.mcpserver import MCPServer, Context
from mcp.types import Tool, TextContent

# Configure logging (redirect to stderr to keep stdout free)
logging.basicConfig(level=logging.WARNING, stream=sys.stderr)
logger = logging.getLogger(__name__)

class DebugHandler(logging.Handler):
    def emit(self, record):
        print(f"DEBUG: {record.levelname}: {record.getMessage()}", file=sys.stderr, flush=True)

logger.addHandler(DebugHandler())
logger.setLevel(logging.WARNING)

def setup_logging(debug_mode=False):
    global logger, DEBUG_MODE
    DEBUG_MODE = debug_mode

    level = logging.DEBUG if debug_mode else logging.WARNING

    logger.setLevel(level)
    logging.getLogger().setLevel(level)

    for logger_name in ("uvicorn", "uvicorn.access", "uvicorn.error", "mcp.server.streamable_http"):
        target_logger = logging.getLogger(logger_name)
        target_logger.setLevel(level)

        if not debug_mode:
            target_logger.propagate = False
            target_logger.handlers = []

def get_debug_mode_from_config():
    try:
        result = subprocess.run(['snapctl', 'get', 'debug'],
                              capture_output=True, text=True, check=True)
        debug_str = result.stdout.strip()
        return debug_str.lower() in ('true', '1', 'yes', 'on')
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False

def get_port_from_config():
    """Get port from snap configuration"""
    try:
        # Try to get port from snap config
        result = subprocess.run(['snapctl', 'get', 'port'],
                              capture_output=True, text=True, check=True)
        port = result.stdout.strip()
        if port:
            return int(port)
    except (subprocess.CalledProcessError, FileNotFoundError, ValueError):
        # If snapctl is not available or config not set, use default
        pass
    return 8005

@dataclass
class ContainerInfo:
    """Represents information about an LXD container"""
    name: str
    status: str
    ipv4: str
    ipv6: str
    architecture: str
    created: str
    updated: str

class LXDManager:
    """Manages LXD containers using pylxd"""

    def __init__(self):
        self.client = Client()
        self.lxd_available = self._check_lxd()
        if not self.lxd_available:
            raise RuntimeError("LXD is not available on this system")

    def _check_lxd(self) -> bool:
        try:
            self.client.api.get()
            logger.debug("LXD API connection successful")
            return True
        except Exception as e:
            logger.error(f"LXD API connection failed: {e}")
            return False

    def list_containers(self) -> List[ContainerInfo]:
        logger.debug("Starting list_containers")
        try:
            containers = []
            container_list = list(self.client.containers.all())
            logger.debug(f"Found {len(container_list)} containers")

            for i, container in enumerate(container_list):
                logger.debug(f"Processing container {i}: {container.name}")
                try:
                    container_info = ContainerInfo(
                        name=str(container.name),
                        status=str(container.status) if hasattr(container, 'status') else 'Unknown',
                        ipv4=str(container.ipv4) if hasattr(container, 'ipv4') else '',
                        ipv6=str(container.ipv6) if hasattr(container, 'ipv6') else '',
                        architecture=str(container.architecture) if hasattr(container, 'architecture') else '',
                        created=str(container.created_at) if hasattr(container, 'created_at') else '',
                        updated=str(container.updated_at) if hasattr(container, 'updated_at') else ''
                    )
                    containers.append(container_info)
                except Exception as e:
                    logger.error(f"Error accessing container info for {container.name}: {e}")
                    fallback_info = ContainerInfo(
                        name=str(container.name), status='Unknown', ipv4='', ipv6='', architecture='', created='', updated=''
                    )
                    containers.append(fallback_info)

            return containers
        except Exception as e:
            logger.error(f"Error in list_containers: {e}")
            return []

    def create_container(self, name: str, image: str = "ubuntu:26.04") -> bool:
        try:
            if ":" in image:
                converted_image = image.split(":")[1]
            else:
                converted_image = image

            config = {
                'name': name,
                'source': {
                    'type': 'image',
                    'mode': 'pull',
                    'server': 'https://cloud-images.ubuntu.com/releases',
                    'protocol': 'simplestreams',
                    'alias': converted_image
                }
            }
            self.client.containers.create(config, wait=True)
            return True
        except Exception as e:
            logger.error(f"Error creating container {name}: {e}")
            return False

    def start_container(self, name: str) -> bool:
        try:
            container = self.client.containers.get(name)
            container.start(wait=True)
            return True
        except Exception as e:
            logger.error(f"Error starting container {name}: {e}")
            return False

debug = get_debug_mode_from_config()
init_log_level = "DEBUG" if debug else "WARNING"

# === 2. SERVER INITIALIZATION ===
mcp = MCPServer("lxd-mcp-server", log_level=init_log_level)
lxd_manager = LXDManager()

@mcp.tool()
async def list_containers(ctx: Context) -> TextContent:
    """List all LXD containers and their current status details."""
    logger.debug("Tool list_containers called")
    containers = lxd_manager.list_containers()

    if not containers:
        return TextContent(type="text", text="No containers found.")

    # Show a nice table
    markdown = "| Name | Status | IPv4 | Architecture |\n"
    markdown += "| --- | --- | --- | --- |\n"
    for c in containers:
        markdown += f"| **{c.name}** | {c.status} | {c.ipv4 or 'N/A'} | {c.architecture} |\n"

    return TextContent(type="text", text=markdown)

@mcp.tool()
async def create_container(name: str, image: str = "ubuntu:26.04") -> TextContent:
    """Create a new LXD container from a specified Ubuntu image release.

    Args:
        name: The unique name for the new container.
        image: The image alias to use (e.g., 'ubuntu:26.04').
    """
    success = lxd_manager.create_container(name, image)
    if success:
        markdown = f"### 🆕 Container Created\n"
        markdown += f"* **Name:** `{name}`\n"
        markdown += f"* **Image:** `{image}`\n\n"
        markdown += f"The container was successfully created. You can now start it using `start_container`."
        return TextContent(type="text", text=markdown)

    return TextContent(type="text", text=f"❌ **Error:** Failed to create container `{name}`.")

@mcp.tool()
async def start_container(name: str) -> TextContent:
    """Start an existing, stopped LXD container.

    Args:
        name: The name of the container to start.
    """
    success = lxd_manager.start_container(name)
    if success:
        markdown = f"### ▶️ Container Started\n"
        markdown += f"Container `{name}` was successfully started and is now booting up."
        return TextContent(type="text", text=markdown)

    return TextContent(type="text", text=f"❌ **Error:** Failed to start container `{name}`.")

@mcp.tool()
async def stop_container(name: str) -> TextContent:
    """Stop a running LXD container.

    Args:
        name: The name of the container to stop.
    """
    logger.debug(f"Stopping container {name}")
    try:
        container = lxd_manager.client.containers.get(name)
        container.stop(wait=True)
        markdown = f"### ⏹️ Container Stopped\n"
        markdown += f"Container `{name}` has been successfully stopped."
        return TextContent(type="text", text=markdown)
    except Exception as e:
        logger.error(f"Error stopping container {name}: {e}")
        return TextContent(type="text", text=f"❌ **Error stopping container `{name}`:** {e}")

@mcp.tool()
async def delete_container(name: str) -> TextContent:
    """Completely delete an LXD container from the host system. The container must be stopped first.

    Args:
        name: The name of the container to delete.
    """
    logger.debug(f"Deleting container {name}")
    try:
        container = lxd_manager.client.containers.get(name)
        container.delete(wait=True)
        markdown = f"### 🗑️ Container Deleted\n"
        markdown += f"Container `{name}` was permanently removed from the system."
        return TextContent(type="text", text=markdown)
    except Exception as e:
        logger.error(f"Error deleting container {name}: {e}")
        return TextContent(type="text", text=f"❌ **Error deleting container `{name}`:** {e}")

@mcp.tool()
async def run_in_container(name: str, command: str) -> TextContent:
    """Execute a shell command inside a specific running container with live UI feedback.

    Args:
        name: The name of the target container.
        command: The shell command to run (e.g., 'apt update' or 'ls -la').
    """
    logger.debug(f"Executing command in container {name}: {command}")
    try:
        container = lxd_manager.client.containers.get(name)

        if container.status != "Running":
            return TextContent(
                type="text",
                text=f"❌ **Error:** Container '{name}' is not running."
            )

        execution_env = {
            "DEBIAN_FRONTEND": "noninteractive",
            "TERM": "xterm",
            "HOME": "/root"
        }

        cmd_args = ["sh", "-c", command]

        await asyncio.sleep(0.05)

        try:
            result = await asyncio.to_thread(
                container.execute, cmd_args, environment=execution_env
            )
        except asyncio.CancelledError:
            logger.warning(f"Command execution cancelled by the UI client while running: '{command}'")

            raise

        # Output formating
        markdown = f"### Command Execution Result\n"
        markdown += f"* **Container:** {name}\n"
        markdown += f"* **Exit Code:** `{result.exit_code}`\n\n"

        if result.stdout:
            markdown += f"**Stdout:**\n```bash\n{result.stdout.strip()}\n```\n"
        if result.stderr:
            markdown += f"**Stderr:**\n```bash\n{result.stderr.strip()}\n```\n"
        if not result.stdout and not result.stderr:
            markdown += "*(Command produced no output)*\n"

        return TextContent(type="text", text=markdown)

    except Exception as e:
        return TextContent(type="text", text=f"❌ **Execution failed:** {str(e)}")

@mcp.tool()
async def push_to_container(name: str, container_path: str, content: str) -> TextContent:
    """Push/upload a text file or script directly into a specific container path.
    Automatically creates parent directories if they do not exist.

    Args:
        name: The name of the target container.
        container_path: The absolute path inside the container where the file should be saved (e.g., '/root/scripts/deploy.sh').
        content: The text content to write into the file.
    """
    logger.debug(f"Pushing file to container {name} at path: {container_path}")
    try:
        container = lxd_manager.client.containers.get(name)

        if container.status != "Running":
            return TextContent(type="text", text=f"❌ **Error:** Container `{name}` is not running. Please start it first.")

        # 1. Automatic directory creation (mkdir -p)
        parent_dir = os.path.dirname(container_path)
        if parent_dir and parent_dir != "/":
            container.execute(["mkdir", "-p", parent_dir])

        # 2. Upload content
        container.files.put(container_path, content)

        # 3. Handle shell scripts execution flag
        is_script = container_path.endswith('.sh')
        if is_script:
            container.execute(["chmod", "+x", container_path])

        markdown = f"### 📤 File Uploaded Successfully\n"
        markdown += f"* **Container:** `{name}`\n"
        markdown += f"* **Target Path:** `{container_path}`\n"
        if is_script:
            markdown += f"* **Permissions:** Automatically made executable (`chmod +x` applied)\n"

        return TextContent(type="text", text=markdown)

    except Exception as e:
        logger.error(f"Failed to push file to container {name}: {e}")
        return TextContent(type="text", text=f"❌ **Upload failed:** {str(e)}")

@mcp.tool()
async def pull_from_container(name: str, container_path: str) -> TextContent:
    """Pull/read the contents of a file from a specific container path.

    Args:
        name: The name of the target container.
        container_path: The absolute path to the file inside the container (e.g., '/etc/nginx/nginx.conf').
    """
    logger.debug(f"Pulling file from container {name} at path: {container_path}")
    try:
        container = lxd_manager.client.containers.get(name)

        if container.status != "Running":
            return TextContent(type="text", text=f"❌ **Error:** Container `{name}` is not running.")

        # Pull raw bytes from LXD socket
        file_bytes = container.files.get(container_path)

        try:
            file_content = file_bytes.decode('utf-8')

            # Determine syntax highlighting language based on file extension
            lang = "text"
            if container_path.endswith(('.sh', '.bash')): lang = "bash"
            elif container_path.endswith(('.json', '.json5')): lang = "json"
            elif container_path.endswith(('.yml', '.yaml')): lang = "yaml"
            elif container_path.endswith(('.conf', '.cfg')): lang = "nginx"  # generic config look

            markdown = f"### 📥 File Content: `{container_path}`\n"
            markdown += f"**Container:** {name}\n\n"
            markdown += f"```{lang}\n"
            markdown += f"{file_content}\n"
            markdown += f"```\n"

            return TextContent(type="text", text=markdown)

        except UnicodeDecodeError:
            return TextContent(type="text", text=f"⚠️ **Binary File:** The file at `{container_path}` is a binary file and cannot be rendered as text.")

    except Exception as e:
        logger.error(f"Failed to pull file from container {name}: {e}")
        return TextContent(type="text", text=f"❌ **Failed to pull file:** {str(e)}")

    """Push multiple files into a container path using a JSON map (supports text and base64 binaries).

    Args:
        name: The name of the target container.
        container_target_dir: The absolute base path inside the container.
        files_data: JSON string mapping paths to a dict: '{"src/logo.png": {"content": "iVBORw...", "encoding": "base64"}, "index.js": {"content": "console.log()", "encoding": "text"}}'
    """
    try:
        container = lxd_manager.client.containers.get(name)
        if container.status != "Running":
            return TextContent(type="text", text=f"❌ **Error:** Container '{name}' is not running.")

        file_map = json.loads(files_data)
        count = 0

        for rel_path, file_info in file_map.items():
            full_container_path = os.path.normpath(os.path.join(container_target_dir, rel_path))
            if not full_container_path.startswith(container_target_dir):
                continue

            parent_dir = os.path.dirname(full_container_path)
            if parent_dir and parent_dir != "/":
                container.execute(["mkdir", "-p", parent_dir])

            raw_content = file_info.get("content", "")
            encoding = file_info.get("encoding", "text")

            if encoding == "base64":
                file_payload = base64.b64decode(raw_content)
            else:
                file_payload = raw_content

            container.files.put(full_container_path, file_payload)
            count += 1

        return TextContent(type="text", text=f"📂 Successfully deployed {count} files (including binaries) to `{container_target_dir}`.")
    except Exception as e:
        return TextContent(type="text", text=f"❌ **Directory push failed:** {str(e)}")

    """Read a directory tree from a container, automatically encoding binaries as base64.

    Args:
        name: The name of the target container.
        container_source_dir: The absolute path of the directory inside the container.
    """
    try:
        container = lxd_manager.client.containers.get(name)
        if container.status != "Running":
            return TextContent(type="text", text=f"❌ **Error:** Container '{name}' is not running.")

        res = container.execute(["sh", "-c", f"find {container_source_dir} -type f"])
        if res.exit_code != 0:
            return TextContent(type="text", text=f"❌ **Error:** Failed to read directory.")

        file_list = res.stdout.strip().split("\n")
        result_map = {}

        for file_path in file_list:
            if not file_path:
                continue
            try:
                file_bytes = container.files.get(file_path)
                rel_path = os.path.relpath(file_path, container_source_dir)

                try:
                    text_content = file_bytes.decode('utf-8')
                    result_map[rel_path] = {"content": text_content, "encoding": "text"}
                except UnicodeDecodeError:
                    b64_content = base64.b64encode(file_bytes).decode('utf-8')
                    result_map[rel_path] = {"content": b64_content, "encoding": "base64"}
            except Exception:
                continue

        markdown = f"### 📥 Directory Tree Retrieved (Binaries encoded as Base64)\n\n```json\n"
        markdown += json.dumps(result_map, indent=2)
        markdown += "\n```"
        return TextContent(type="text", text=markdown)
    except Exception as e:
        return TextContent(type="text", text=f"❌ **Directory pull failed:** {str(e)}")

# === 3. RUN THE SERVER ===
if __name__ == "__main__":
    debug = get_debug_mode_from_config()
    setup_logging(debug)

    srv_port = get_port_from_config()

    logger.warning(f"Starting MCP server on port {srv_port}")

    mcp.run(
        transport="streamable-http",
        host="0.0.0.0",
        port=srv_port
    )
